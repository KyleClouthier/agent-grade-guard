{
  "name": "agentdecoy",
  "version": "2.4.3",
  "description": "Security for the AI-agent era: decoys that catch hostile AI agents (fake keys, AI tool configs, MCP and AI servers, agent panels) and a shared network that locks them out. One-file installs for Next.js, Vercel, Netlify, Firebase, Cloudflare and Express (npx agentdecoy init). Never blocks search engines.",
  "type": "module",
  "main": "./src/guard-core.js",
  "exports": {
    ".": "./src/guard-core.js",
    "./express": "./src/express.js",
    "./cloudflare": "./src/cloudflare-worker.js",
    "./next": "./src/next.js",
    "./vercel": "./src/vercel.js",
    "./netlify": "./src/netlify.js",
    "./firebase": {
      "import": "./src/firebase.js",
      "require": "./src/firebase.cjs"
    },
    "./env": "./src/env.js"
  },
  "bin": {
    "agentdecoy": "./bin/agentdecoy.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "wrangler.jsonc"
  ],
  "scripts": {
    "test": "node test/test-core.mjs && node test/test-installs.mjs"
  },
  "keywords": [
    "security",
    "ai-agent-security",
    "ai-agents",
    "honeypot",
    "deception",
    "mcp",
    "vibe-coding",
    "nextjs",
    "vercel",
    "netlify",
    "firebase",
    "express",
    "cloudflare-workers",
    "prompt-injection",
    "threat-intelligence",
    "crowdsourced-security",
    "agentdecoy"
  ],
  "author": "Kyle Clouthier, Clouthier Simulation Labs (https://simgen.dev/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleClouthier/agentdecoy.git"
  },
  "homepage": "https://simgen.dev/agentdecoy/guard/",
  "engines": {
    "node": ">=18"
  }
}
