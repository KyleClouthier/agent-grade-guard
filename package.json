{
  "name": "agentdecoy",
  "version": "2.2.1",
  "description": "Decoys that catch hostile AI agents and attack bots in the act, with threat intelligence shared across every protected site. One-file installs for Next.js, Vercel, Netlify, Firebase, Cloudflare and Express (npx agentdecoy init). Never blocks search engines or AI search bots.",
  "type": "module",
  "main": "./src/guard-core.js",
  "exports": {
    ".": "./src/guard-core.js",
    "./express": "./src/express.js",
    "./cloudflare": "./src/cloudflare-worker.js",
    "./next": "./src/next.js",
    "./vercel": "./src/vercel.js",
    "./netlify": "./src/netlify.js",
    "./firebase": {
      "import": "./src/firebase.js",
      "require": "./src/firebase.cjs"
    },
    "./env": "./src/env.js"
  },
  "bin": {
    "agentdecoy": "./bin/agentdecoy.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "wrangler.jsonc"
  ],
  "scripts": {
    "test": "node test/test-core.mjs && node test/test-installs.mjs"
  },
  "keywords": [
    "security",
    "honeypot",
    "ai agents",
    "bots",
    "cloudflare",
    "nextjs",
    "express",
    "crowdsourced-security",
    "blocklist",
    "ai-agents",
    "prompt-injection",
    "llms-txt",
    "cloudflare-workers",
    "agentdecoy",
    "ai-agent-security",
    "threat-intelligence",
    "deception"
  ],
  "author": "Kyle Clouthier, Clouthier Simulation Labs (https://simgen.dev/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleClouthier/agentdecoy.git"
  },
  "homepage": "https://simgen.dev/agentdecoy/guard/",
  "engines": {
    "node": ">=18"
  }
}
